{
  "info": {
    "name": "Movie Catalog GraphQL — Test Suite",
    "description": "GraphQL test suite for the System Integration exam (movie catalog API).\n\nRun with the Collection Runner top-to-bottom. The 'Positive — Mutation lifecycle' folder runs addMovie → updateMovie → deleteMovie in order: addMovie stores the new id in the createdMovieId variable, updateMovie and deleteMovie reuse it, and deleteMovie removes the movie again so the suite is repeatable on the shared database.\n\nbaseUrl defaults to http://localhost:8000/graphql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Positive — Queries",
      "item": [
        {
          "name": "Q1 movie by id (exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test('movie returned', () => pm.expect(json.data.movie).to.not.be.null);",
                  "pm.test('correct id', () => pm.expect(json.data.movie.id).to.eql('1'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"{ movie(id: \\\"1\\\") { id title releaseYear genres { name } } }\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          }
        },
