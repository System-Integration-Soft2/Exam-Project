    {
      "name": "6. Security — SQL injection is neutralized",
      "item": [
        {
          "name": "N11 injection payload treated as a literal value",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no errors (input was parameterized, not executed)', () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test('returns an array (no match for the literal string)', () => pm.expect(json.data.movies).to.be.an('array'));",
                  "// The query below would fail later in the run if the table had been dropped,",
                  "// which itself proves the injection did not execute."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"{ movies(genre: \\\"'; DROP TABLE movies; --\\\") { id title } }\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          }
        }
      ]
    }
