    {
      "name": "2. Positive — Mutation lifecycle (create → update → delete)",
      "item": [
        {
          "name": "M1 addMovie (with genres) — stores id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test('movie created with id', () => pm.expect(json.data.addMovie.id).to.be.a('string').and.not.empty);",
                  "pm.test('title echoed back', () => pm.expect(json.data.addMovie.title).to.eql('Postman Lifecycle Movie'));",
                  "pm.test('two genres linked', () => pm.expect(json.data.addMovie.genres.length).to.eql(2));",
                  "pm.collectionVariables.set('createdMovieId', json.data.addMovie.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"mutation { addMovie(title: \\\"Postman Lifecycle Movie\\\", releaseYear: 2021, genreIds: [\\\"1\\\", \\\"3\\\"]) { id title releaseYear genres { name } } }\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          }
        },
        {
          "name": "M2 updateMovie (partial — reuses stored id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test('director updated', () => pm.expect(json.data.updateMovie.director).to.eql('Updated Director'));",
                  "pm.test('release year updated', () => pm.expect(json.data.updateMovie.releaseYear).to.eql(2022));",
                  "pm.test('same id as created', () => pm.expect(json.data.updateMovie.id).to.eql(pm.collectionVariables.get('createdMovieId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"mutation { updateMovie(id: \\\"{{createdMovieId}}\\\", director: \\\"Updated Director\\\", releaseYear: 2022) { id director releaseYear } }\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            }
          }
        },
        {
          "name": "M3 deleteMovie (reuses stored id — cleans up)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
