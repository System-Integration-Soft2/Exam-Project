        {
          "name": "ListMovies (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://soapservice.example.com/movies/service/IMovieService/ListMovies\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"http://soapservice.example.com/movies/service\">\n  <soap:Body>\n    <tns:ListMovies />\n  </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "{{base_url}}/movies.svc",
              "host": ["{{base_url}}"],
              "path": ["movies.svc"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains Items element', function () {",
                  "    pm.expect(pm.response.text()).to.include('<a:Items>');",
                  "});",
                  "pm.test('Response contains Inception', function () {",
                  "    pm.expect(pm.response.text()).to.include('Inception');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
