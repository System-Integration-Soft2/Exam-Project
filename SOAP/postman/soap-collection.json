        {
          "name": "CreateMovie (positive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://soapservice.example.com/movies/service/IMovieService/CreateMovie\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"http://soapservice.example.com/movies/service\" xmlns:m=\"http://soapservice.example.com/movies\">\n  <soap:Body>\n    <tns:CreateMovie>\n      <tns:request>\n        <m:Title>Postman Test Movie</m:Title>\n        <m:Director>Test Director</m:Director>\n        <m:ReleaseYear>2024</m:ReleaseYear>\n        <m:RuntimeMinutes>120</m:RuntimeMinutes>\n        <m:Synopsis>A movie created via Postman to verify the CreateMovie operation.</m:Synopsis>\n        <m:GenreIds xmlns:a=\"http://schemas.microsoft.com/2003/10/Serialization/Arrays\"><a:int>1</a:int><a:int>2</a:int></m:GenreIds>\n      </tns:request>\n    </tns:CreateMovie>\n  </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "{{base_url}}/movies.svc",
              "host": ["{{base_url}}"],
              "path": ["movies.svc"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains created movie title', function () {",
                  "    pm.expect(pm.response.text()).to.include('Postman Test Movie');",
                  "});",
                  "pm.test('Response contains non-zero Id', function () {",
                  "    pm.expect(pm.response.text()).to.match(/<a:Id>[1-9][0-9]*<\\/a:Id>/);",
                  "});",
                  "pm.test('Response contains CreatedAt timestamp', function () {",
                  "    pm.expect(pm.response.text()).to.include('<a:CreatedAt>');",
                  "});",
                  "var idMatch = pm.response.text().match(/<a:Id>([1-9][0-9]*)<\\/a:Id>/);",
                  "if (idMatch) { pm.collectionVariables.set('createdMovieId', idMatch[1]); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
