# SQLite database path (mounted volume)
DATABASE_PATH=/data/catalog.db

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# JWT signing secret — CHANGE THIS before any non-local deployment.
# Must be at least 32 characters.
JWT_SECRET=CHANGE_ME_use_a_random_secret_of_at_least_32_characters_here

# JWT algorithm (HS256 is the only supported value)
JWT_ALGORITHM=HS256

# Access token TTL in seconds
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token TTL in seconds
REFRESH_TOKEN_TTL_SECONDS=604800

JWT_ISSUER=rest-api
JWT_AUDIENCE=rest-api

# Comma-separated list of allowed CORS origins..
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bootstrap admin credentials — ROTATE before any non-local deployment.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

LOG_LEVEL=INFO
